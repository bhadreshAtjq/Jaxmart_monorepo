# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=jaxmart-prod-media
# AWS_S3_ENDPOINT=https://t3.storageapi.dev

# Razorpay  
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (AWS SES or SMTP)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_ses_smtp_user
SMTP_PASS=your_ses_smtp_password
EMAIL_FROM=noreply@yourplatform.com

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE=+1234567890

# KYC (Signzy)
SIGNZY_API_KEY=your_signzy_api_key
SIGNZY_BASE_URL=https://preproduction.signzy.app/api/v2

# Frontend URLs (for CORS)
