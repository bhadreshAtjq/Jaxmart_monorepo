// ═══════════════════════════════════════════════════════════════════════════════
// COMPREHENSIVE B2B PLATFORM SCHEMA
// Covers: Users · KYC · Catalog · Products · Services · RFQ · Quotes · Orders
//         Escrow · Milestones · Disputes · Messaging · Notifications · Analytics
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserType {
  BUYER
  SELLER
  BOTH
}enum AccountType {
  INDIVIDUAL
  BUSINESS
}enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  UNDER_REVIEW
}enum ListingType {
  PRODUCT
  SERVICE
}enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  REJECTED
  ARCHIVED
}enum ServiceMode {
  ONSITE
  REMOTE
  HYBRID
}enum RfqType {
  PRODUCT
  SERVICE
  BOTH
}enum RfqStatus {
  OPEN
  CLOSED
  AWARDED
  EXPIRED
  CANCELLED
}enum RfqVisibility {
  PUBLIC
  PRIVATE
  TARGETED
}
enum QuoteStatus {
  DRAFT
  SUBMITTED
  SHORTLISTED
  WON
  LOST
  WITHDRAWN
  EXPIRED
}enum OrderType {
  PRODUCT
  SERVICE
}enum OrderStatus {
  CREATED
  ACCEPTED
  ACTIVE
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
  REFUNDED
}enum EscrowStatus {
  HELD
  PARTIAL_RELEASED
  FULLY_RELEASED
  REFUNDED
  FROZEN
}enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  DISPUTED
  RELEASED
  CANCELLED
}enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  RESOLVED_PARTIAL
  WITHDRAWN
}enum AddressType {
  PRIMARY
  BRANCH
  BILLING
  SHIPPING
  WAREHOUSE
}enum EmployeeRange {
  ONE_TO_TEN
  ELEVEN_TO_FIFTY
  FIFTY_ONE_TO_TWO_HUNDRED
  TWO_HUNDRED_PLUS
}enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  BROCHURE
}enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}
enum PriceType {
  FIXED
  NEGOTIABLE
  ON_REQUEST
  RANGE
}
enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
  CANCELLED
}enum NotificationType {
  RFQ_MATCH
  RFQ_INVITED
  RFQ_EXPIRED
  QUOTE_RECEIVED
  QUOTE_SHORTLISTED
  QUOTE_AWARDED
  QUOTE_EXPIRED
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_COMPLETED
  MILESTONE_SUBMITTED
  MILESTONE_APPROVED
  MILESTONE_DISPUTED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  KYC_APPROVED
  KYC_REJECTED
  NEW_MESSAGE
  REVIEW_RECEIVED
  SYSTEM
}enum ConversationContext {
  RFQ
  QUOTE
  ORDER
  LISTING
  GENERAL
}enum ReviewType {
  BUYER_TO_SELLER
  SELLER_TO_BUYER
}enum InventoryTxType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVED
  RELEASED
}
// USERS & IDENTITY
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id          String      @id @default(uuid())
  email       String?     @unique
  phone       String      @unique
  fullName    String
  userType    UserType    @default(BUYER)
  accountType AccountType @default(INDIVIDUAL)
  kycStatus   KycStatus   @default(PENDING)

  // Trust & reputation
  trustScore        Int     @default(0)        // 0–100 computed score
  sellerRating      Float   @default(0)
  buyerRating       Float   @default(0)
  totalOrdersPlaced Int     @default(0)
  totalOrdersFulfilled Int  @default(0)
  responseRatePercent Float @default(0)        // % of RFQs quoted
  avgResponseHours    Float @default(0)

  // Profile
  isActive     Boolean @default(true)
  isAdmin      Boolean @default(false)
  avatarUrl    String?
  coverUrl     String?
  fcmToken     String?
  hasSeenTour  Boolean @default(false)
  language     String  @default("en")
  timezone     String  @default("Asia/Kolkata")
  currency     String  @default("INR")

  // Timestamps
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ── Relations ──
  businessProfile BusinessProfile?
  addresses       Address[]
  kycDocuments    KycDocument[]
  refreshTokens   RefreshToken[]

  listings        Listing[]
  productVariants ProductVariant[]          // seller can be directly on variant (future)

  rfqRequests     RfqRequest[]
  rfqQuotes       RfqQuote[]
  rfqInvites      RfqInvite[]               // targeted RFQ invites received

  buyerOrders     Order[]        @relation("BuyerOrders")
  sellerOrders    Order[]        @relation("SellerOrders")

  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")

  notifications   Notification[]
  conversations   ConversationParticipant[]

  savedListings   SavedListing[]
  savedRfqs       SavedRfq[]

  subscription    Subscription?
  invoices        SubscriptionInvoice[]
  depositReceipts DepositReceipt[]
  payments        Payment[]

  @@index([kycStatus])
  @@index([userType])
  @@index([createdAt])
  @@map("users")
}

model BusinessProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  businessName    String
  gstin           String?        @unique
  pan             String?
  mcaCin          String?
  msmeNumber      String?
  udyamNumber     String?                    // NEW: MSME Udyam registration
  iecCode         String?                    // NEW: Import Export Code
  establishedYear Int?
  employeeRange   EmployeeRange?
  annualTurnover  String?
  website         String?
  linkedinUrl     String?
  description     String?
  businessType    String?                    // Manufacturer / Trader / Service Provider / Distributor
  exportCapable   Boolean        @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  certifications  BusinessCertification[]    // NEW: ISO, FSSAI, BIS, etc.

  @@map("business_profiles")
}

model BusinessCertification {
  id                String          @id @default(uuid())
  businessProfileId String
  certName          String          // "ISO 9001:2015", "FSSAI", "BIS"
  certNumber        String?
  issuingBody       String?
  validFrom         DateTime?
  validUntil        DateTime?
  documentUrl       String?
  isVerified        Boolean         @default(false)
  createdAt         DateTime        @default(now())

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@map("business_certifications")
}

model Address {
  id          String      @id @default(uuid())
  userId      String
  addressType AddressType @default(PRIMARY)
  label       String?                        // "Mumbai Office", "Delhi Warehouse"
  contactName String?
  contactPhone String?
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  pincode     String
  country     String      @default("India")
  // PostGIS point for geo queries
  lat         Float?
  lng         Float?
  isPrimary   Boolean     @default(false)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings    Listing[]
  rfqRequests RfqRequest[]

  @@index([userId])
  @@index([pincode])
  @@index([city, state])
  @@map("addresses")
}

model KycDocument {
  id                 String    @id @default(uuid())
  userId             String
  documentType       String    // "AADHAAR", "PAN", "GSTIN", "GST_CERTIFICATE", "DRIVING_LICENSE", "UDYAM_MSME"
  documentNumber     String?   // PAN/GSTIN/Aadhaar/DL/Udyam number
  documentUrl        String
  backSideUrl        String?
  status             KycStatus @default(PENDING)
  verificationMethod String?   @default("API_SETU") // "API_SETU", "SIGNZY", "MANUAL"
  txnId              String?   // API Setu / Provider transaction ID
  metadata           Json?     // Government API response data
  reviewNote         String?
  reviewedBy         String?   // admin user id
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("kyc_documents")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORIES & TAXONOMY
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id             String       @id @default(uuid())
  parentId       String?
  name           String
  slug           String       @unique
  applicableType ListingType?
  depthLevel     Int          @default(1)  // 1=root, 2=sub, 3=leaf
  iconUrl        String?
  bannerUrl      String?
  metaTitle      String?
  metaDescription String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  parent      Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]      @relation("CategoryTree")
  listings    Listing[]
  rfqRequests RfqRequest[]
  attributes  CategoryAttribute[]    // NEW: category-specific attributes

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// NEW: defines what attributes a category has (e.g. Electronics → "RAM", "Storage")
model CategoryAttribute {
  id           String        @id @default(uuid())
  categoryId   String
  name         String        // "RAM", "Color", "Material"
  slug         String        // "ram", "color", "material"
  unit         String?       // "GB", "kg", "mm"
  attributeType AttributeType @default(TEXT)
  isRequired   Boolean       @default(false)
  isFilterable Boolean       @default(true)
  sortOrder    Int           @default(0)
  options      Json?         // for SELECT/MULTI_SELECT: ["Red","Blue","Green"]
  createdAt    DateTime      @default(now())

  category           Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productAttributeValues ProductAttributeValue[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("category_attributes")
}

// ─────────────────────────────────────────────────────────────────────────────
// LISTINGS (UNIFIED PRODUCT + SERVICE)
// ─────────────────────────────────────────────────────────────────────────────

model Listing {
  id           String        @id @default(uuid())
  sellerId     String
  categoryId   String
  locationId   String?
  listingType  ListingType
  title        String
  slug         String        @unique @default(dbgenerated("gen_random_uuid()"))
  description  String        // rich text / markdown
  shortDesc    String?       // used in cards/previews
  status       ListingStatus @default(DRAFT)
  isFeatured   Boolean       @default(false)
  isVerified   Boolean       @default(false)   // admin-verified listing

  // SEO
  metaTitle    String?
  metaKeywords String[]

  // Stats (denormalized for fast reads)
  avgRating    Float  @default(0)
  reviewCount  Int    @default(0)
  viewCount    Int    @default(0)
  enquiryCount Int    @default(0)
  quoteCount   Int    @default(0)
  saveCount    Int    @default(0)

  // Search
  searchVector String?   // tsvector stored as text, updated via trigger
  tags         String[]

  // Timestamps
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ── Relations ──
  seller        User           @relation(fields: [sellerId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  location      Address?       @relation(fields: [locationId], references: [id])
  productDetail ProductDetail?
  serviceDetail ServiceDetail?
  media         ListingMedia[]
  variants      ProductVariant[]          // NEW: product variants
  rfqQuotes     RfqQuote[]
  savedBy       SavedListing[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([listingType])
  @@index([isFeatured])
  @@index([tags])
  @@map("listings")
}

model ListingMedia {
  id        String    @id @default(uuid())
  listingId String
  variantId String?   // NEW: media can belong to a specific variant
  url       String
  thumbUrl  String?
  mediaType MediaType @default(IMAGE)
  altText   String?
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  listing Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([listingId])
  @@map("listing_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT DETAIL + VARIANTS + ATTRIBUTES
// ─────────────────────────────────────────────────────────────────────────────

model ProductDetail {
  id               String  @id @default(uuid())
  listingId        String  @unique
  brand            String?
  model            String?
  sku              String?                  // base SKU (variants have their own)
  unitOfMeasure    String                   // "kg", "piece", "box", "litre"
  minOrderQty      Float   @default(1)
  maxOrderQty      Float?
  priceType        PriceType @default(FIXED)
  pricePerUnit     Float?
  priceRangeMin    Float?                   // for RANGE type
  priceRangeMax    Float?
  currency         String  @default("INR")
  bulkPriceSlabs   Json?                    // [{minQty:100, maxQty:499, price:45}, ...]
  stockAvailable   Boolean @default(true)
  totalStock       Int?                     // managed in InventoryLog
  leadTimeDays     Int?
  hsnCode          String?
  gstRate          Float?
  specifications   Json?                    // free-form key-value specs
  countryOfOrigin  String?
  supplyAbility    String?                  // "5000 units/month"
  deliveryTime     String?
  packagingDetails String?
  packagingUnit    String?                  // "per carton", "per pallet"
  paymentTerms     String?                  // "50% advance, 50% on delivery"
  fobPort          String?
  sampleAvailable  Boolean @default(false)
  samplePrice      Float?
  warranty         String?
  returnPolicy     String?
  certifications   String[]                 // ["ISI", "CE", "RoHS"]

  listing  Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@map("product_details")
}

// NEW: Product Variants (e.g., Red/M, Blue/L)
model ProductVariant {
  id             String   @id @default(uuid())
  listingId      String
  productDetailId String
  sellerId       String   // denormalized for fast seller queries
  sku            String?  @unique
  title          String   // "Red / XL"
  priceOverride  Float?   // if null, inherits from ProductDetail
  stockQty       Int      @default(0)
  reservedQty    Int      @default(0)      // qty in active orders
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listing       Listing                @relation(fields: [listingId], references: [id], onDelete: Cascade)
  productDetail ProductDetail          @relation(fields: [productDetailId], references: [id], onDelete: Cascade)
  seller        User                   @relation(fields: [sellerId], references: [id])
  attributeValues ProductAttributeValue[]
  media         ListingMedia[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@index([listingId])
  @@index([sku])
  @@index([sellerId])
  @@map("product_variants")
}

// NEW: Stores the actual attribute value per variant
model ProductAttributeValue {
  id          String @id @default(uuid())
  variantId   String
  attributeId String
  value       String  // "Red", "8", "true"
  unit        String? // "GB"

  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id])

  @@unique([variantId, attributeId])
  @@index([attributeId, value])   // fast filter: all Red variants
  @@map("product_attribute_values")
}

// NEW: Full inventory tracking per variant
model InventoryLog {
  id        String           @id @default(uuid())
  variantId String
  txType    InventoryTxType
  qtyChange Int              // positive = in, negative = out
  qtyBefore Int
  qtyAfter  Int
  reference String?          // orderId, adjustmentId, etc.
  note      String?
  createdAt DateTime         @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([createdAt])
  @@map("inventory_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICE DETAIL
// ─────────────────────────────────────────────────────────────────────────────

model ServiceDetail {
  id                String      @id @default(uuid())
  listingId         String      @unique
  serviceMode       ServiceMode @default(REMOTE)
  providerType      AccountType @default(INDIVIDUAL)

  // Pricing
  priceType         PriceType   @default(ON_REQUEST)
  basePrice         Float?
  priceUnit         String?     // "per hour", "per project", "per day"
  currency          String      @default("INR")

  // Scope
  serviceArea       String[]    // ["Mumbai", "Pune", "Pan India"]
  capacitySlots     Int         @default(1)
  typicalDuration   String?     // "3–5 days", "2 weeks"
  minEngagementDays Int?
  maxEngagementDays Int?

  // Provider profile
  portfolioItems    Json[]      // [{title, url, description, mediaUrl}]
  certifications    Json[]      // [{name, body, year, docUrl}]
  skillsTags        String[]
  toolsTags         String[]    // NEW: "AutoCAD", "Photoshop", "Python"
  languages         String[]
  avgResponseHrs    Float?
  teamSize          Int?

  // Packages (NEW: tiered pricing)
  packages          ServicePackage[]

  listing           Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

// NEW: Service Packages (Basic / Standard / Premium)
model ServicePackage {
  id              String   @id @default(uuid())
  serviceDetailId String
  name            String   // "Basic", "Standard", "Premium"
  description     String?
  price           Float
  currency        String   @default("INR")
  deliveryDays    Int
  revisionsCount  Int      @default(1)
  includesItems   Json[]   // list of included features
  isPopular       Boolean  @default(false)
  sortOrder       Int      @default(0)

  serviceDetail ServiceDetail @relation(fields: [serviceDetailId], references: [id], onDelete: Cascade)

  @@index([serviceDetailId])
  @@map("service_packages")
}

// ─────────────────────────────────────────────────────────────────────────────
// RFQ SYSTEM (comprehensive)
// ─────────────────────────────────────────────────────────────────────────────

model RfqRequest {
  id          String        @id @default(uuid())
  buyerId     String
  categoryId  String
  locationId  String?

  // Core
  rfqType     RfqType
  title       String
  description String
  quantity    Float?                         // NEW: requested quantity
  unitOfMeasure String?                      // NEW: "kg", "units", "hours"
  specifications Json?                       // NEW: structured specs the buyer needs

  // Budget
  budgetMin   Float?
  budgetMax   Float?
  currency    String        @default("INR")
  budgetFlexible Boolean    @default(false)  // NEW: open to negotiation

  // Timeline
  deadline    DateTime?                      // when buyer needs delivery
  expiresAt   DateTime?                      // RFQ stops accepting quotes
  preferredDeliveryDate DateTime?            // NEW

  // Location / mode
  locationPreference    String?
  deliveryAddressId     String?              // NEW: specific delivery address
  preferredProviderType AccountType?
  preferredServiceMode  ServiceMode?         // NEW: ONSITE / REMOTE / HYBRID

  // Visibility
  visibility  RfqVisibility @default(PUBLIC)
  maxQuotes   Int?                           // NEW: close after N quotes
  isAnonymous Boolean       @default(false)  // NEW: hide buyer identity

  // Status & counts
  status      RfqStatus     @default(OPEN)
  quotesCount Int            @default(0)
  shortlistedCount Int       @default(0)     // NEW
  viewCount   Int            @default(0)

  // Attachments & meta
  attachments Json[]
  tags        String[]
  source      String?                        // "web", "app", "api"
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // ── Relations ──
  buyer       User           @relation(fields: [buyerId], references: [id])
  category    Category       @relation(fields: [categoryId], references: [id])
  location    Address?       @relation(fields: [locationId], references: [id])
  quotes      RfqQuote[]
  invites     RfqInvite[]                    // targeted invitations
  savedBy     SavedRfq[]

  @@index([buyerId])
  @@index([categoryId])
  @@index([status])
  @@index([rfqType])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("rfq_requests")
}

// NEW: For TARGETED RFQs — buyer invites specific sellers
model RfqInvite {
  id        String   @id @default(uuid())
  rfqId     String
  sellerId  String
  invitedAt DateTime @default(now())
  viewedAt  DateTime?
  declined  Boolean  @default(false)
  declineReason String?

  rfq    RfqRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  seller User       @relation(fields: [sellerId], references: [id])

  @@unique([rfqId, sellerId])
  @@index([sellerId])
  @@map("rfq_invites")
}

model RfqQuote {
  id             String      @id @default(uuid())
  rfqId          String
  sellerId       String
  listingId      String?                    // optional: tied to a listing
  variantId      String?                    // NEW: specific variant quoted

  // Pricing
  quotedAmount   Float
  currency       String      @default("INR")
  gstInclusive   Boolean     @default(false)
  gstRate        Float?
  totalWithGst   Float?

  // Proposal
  proposalText   String
  coverNote      String?                    // NEW: short cover note for listing cards
  milestonePlan  Json[]                     // [{title, amount, dueDate, description}]
  timelineDays   Int
  validUntil     DateTime?                  // NEW: quote expiry

  // Terms
  paymentTerms   String?
  warrantyTerms  String?
  deliveryTerms  String?                    // NEW: Incoterms / delivery conditions
  attachments    Json[]

  // Status
  status         QuoteStatus @default(SUBMITTED)
  rejectionNote  String?                    // NEW: why buyer rejected
  submittedAt    DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // ── Relations ──
  rfq     RfqRequest @relation(fields: [rfqId], references: [id])
  seller  User       @relation(fields: [sellerId], references: [id])
  listing Listing?   @relation(fields: [listingId], references: [id])
  order   Order?

  @@index([rfqId])
  @@index([sellerId])
  @@index([status])
  @@index([submittedAt])
  @@map("rfq_quotes")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id               String       @id @default(uuid())
  orderNumber      String       @unique @default(dbgenerated("gen_random_uuid()"))
  buyerId          String
  sellerId         String
  rfqQuoteId       String?      @unique
  orderType        OrderType
  status           OrderStatus  @default(CREATED)

  // Financials
  subtotal         Float        @default(0)
  discountAmount   Float        @default(0)
  taxAmount        Float        @default(0)
  shippingAmount   Float        @default(0)
  totalAmount      Float        @default(0)
  platformFeeRate  Float        @default(0.02)   // 2%
  platformFee      Float        @default(0)
  sellerPayout     Float        @default(0)
  currency         String       @default("INR")

  // Escrow
  escrowStatus          EscrowStatus @default(HELD)
  totalReleasedAmount   Float        @default(0)
  totalRefundedAmount   Float        @default(0)

  // Payment
  paymentStatus    PaymentStatus @default(PENDING)
  razorpayOrderId  String?
  razorpayPaymentId String?
  paidAt           DateTime?

  // Contract
  contractUrl      String?
  contractSignedAt DateTime?
  contractSignedByBuyer  Boolean @default(false)
  contractSignedBySeller Boolean @default(false)

  // Logistics (for product orders)
  shippingAddressId String?
  trackingNumber   String?
  trackingUrl      String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  expectedDeliveryAt DateTime?

  // Metadata
  cancelReason     String?
  cancelledBy      String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── Relations ──
  buyer     User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller    User          @relation("SellerOrders", fields: [sellerId], references: [id])
  rfqQuote  RfqQuote?     @relation(fields: [rfqQuoteId], references: [id])
  items     OrderItem[]                              // NEW: line items
  milestones Milestone[]
  payments  Payment[]                               // NEW: payment records
  reviews   Review[]
  disputes  Dispute[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

// NEW: Line items on an order (supports multiple products/variants per order)
model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  variantId    String?
  title        String  // snapshot of product title at order time
  sku          String?
  quantity     Float
  unitPrice    Float
  totalPrice   Float
  gstRate      Float?
  taxAmount    Float   @default(0)
  specifications Json? // buyer's specific requirements for this item

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// NEW: Payment records (supports partial payments, installments)
model Payment {
  id                String        @id @default(uuid())
  userId            String?
  orderId           String?
  milestoneId       String?
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  signature         String?
  paymentMethod     String?       // "upi", "netbanking", "card"
  failureReason     String?
  metadata          Json?
  gatewayResponse   Json?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt @default(now())

  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// MILESTONES
// ─────────────────────────────────────────────────────────────────────────────

model Milestone {
  id               String          @id @default(uuid())
  orderId          String
  title            String
  description      String?
  amount           Float
  percentOfTotal   Float?          // NEW: e.g. 30% of order total
  dueDate          DateTime?
  status           MilestoneStatus @default(PENDING)

  // Submission
  submissionNote   String?
  submissionFiles  Json[]          // [{url, name, type}]
  submittedAt      DateTime?

  // Approval
  approvedAt       DateTime?
  approvedBy       String?         // buyer userId
  rejectionNote    String?         // NEW

  // Payout
  releasedAt       DateTime?
  payoutTxId       String?         // NEW: payment gateway txn for this milestone

  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  disputes Dispute[]

  @@index([orderId])
  @@index([status])
  @@map("milestones")
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id          String     @id @default(uuid())
  orderId     String
  reviewerId  String
  revieweeId  String
  reviewType  ReviewType
  rating      Int        // 1–5
  comment     String?
  // Sub-ratings
  qualityRating    Int?
  communicationRating Int?
  deliveryRating   Int?
  valueRating      Int?
  // Response from reviewee
  replyText   String?
  repliedAt   DateTime?
  isVerified  Boolean    @default(true)
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  order    Order @relation(fields: [orderId], references: [id])
  reviewer User  @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User  @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([orderId, reviewerId])
  @@index([revieweeId])
  @@index([rating])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// DISPUTES
// ─────────────────────────────────────────────────────────────────────────────

model Dispute {
  id             String        @id @default(uuid())
  orderId        String
  milestoneId    String?
  raisedById     String
  raisedAgainstId String?      // NEW: explicit other party
  reason         String        // "QUALITY_ISSUE", "NON_DELIVERY", "PAYMENT_DISPUTE"
  description    String
  buyerEvidence  Json[]        // [{url, name, description}]
  sellerEvidence Json[]
  status         DisputeStatus @default(OPEN)
  assignedToAdmin String?      // NEW: admin handling this dispute
  mediatorNote   String?
  resolutionNote String?
  buyerRefund    Float?
  sellerPayout   Float?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order     Order      @relation(fields: [orderId], references: [id])
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  timeline  DisputeEvent[]    // NEW: audit trail of all actions

  @@index([orderId])
  @@index([status])
  @@map("disputes")
}

// NEW: Full audit trail for disputes
model DisputeEvent {
  id        String   @id @default(uuid())
  disputeId String
  actorId   String?  // user or admin who did this
  actorRole String?  // "BUYER", "SELLER", "ADMIN"
  eventType String   // "OPENED", "EVIDENCE_ADDED", "ADMIN_ASSIGNED", "RESOLVED"
  note      String?
  metadata  Json?
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id        String              @id @default(uuid())
  context   ConversationContext @default(GENERAL)
  rfqId     String?
  orderId   String?
  listingId String?
  subject   String?
  isArchived Boolean            @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([rfqId])
  @@index([orderId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?    // NEW: for unread count
  isMuted        Boolean  @default(false)   // NEW
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  contentType    String   @default("TEXT")   // "TEXT", "QUOTE_ATTACHMENT", "ORDER_UPDATE"
  attachments    Json[]
  replyToId      String?   // NEW: threaded replies
  isEdited       Boolean   @default(false)
  editedAt       DateTime?
  isDeleted      Boolean   @default(false)   // soft delete
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?            // entityId, entityType, deepLink
  isRead    Boolean          @default(false)
  readAt    DateTime?
  channels  String[]         @default(["IN_APP"])  // ["IN_APP", "PUSH", "EMAIL", "SMS"]
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// SAVED / WISHLIST
// ─────────────────────────────────────────────────────────────────────────────

model SavedListing {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("saved_listings")
}

model SavedRfq {
  id      String   @id @default(uuid())
  userId  String
  rfqId   String
  savedAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rfq  RfqRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@unique([userId, rfqId])
  @@map("saved_rfqs")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM CONFIG & EVENTS
// ─────────────────────────────────────────────────────────────────────────────

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique    // "platform_fee_rate", "rfq_expiry_default_days"
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime @default(now())
  location    String?
  mediaUrl    String?
  ctaUrl      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// NEW: For tracking platform-level analytics events
model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventName String   // "listing_viewed", "rfq_submitted", "quote_sent"
  entityType String? // "Listing", "RfqRequest", "Order"
  entityId  String?
  metadata  Json?
  sessionId String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("analytics_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBSCRIPTIONS & BILLING MODULE
// ─────────────────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  BASIC
  VERIFIED
  GOLD
  ASSESSED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum DepositStatus {
  PENDING
  VERIFIED
  REJECTED
}

model SubscriptionPlan {
  id                        String             @id @default(uuid())
  name                      String             @unique
  slug                      String             @unique
  description               String
  monthlyPrice              Float
  yearlyPrice               Float
  currency                  String             @default("INR")
  maxProducts               Int                @default(10) // -1 for unlimited
  maxImagesPerProduct       Int                @default(5)
  maxVideosPerProduct       Int                @default(0)
  allowBulkUpload           Boolean            @default(false)
  allowApiAccess            Boolean            @default(false)
  verificationBadge         String             @default("NONE") // NONE, VERIFIED, GOLD, ASSESSED
  featuredProductSlots      Int                @default(0)
  hasAdvancedAnalytics      Boolean            @default(false)
  hasCompetitorBenchmarking Boolean            @default(false)
  supportLevel              String             @default("EMAIL_ONLY") // EMAIL_ONLY, EMAIL_CHAT, PRIORITY, DEDICATED
  isActive                  Boolean            @default(true)
  displayOrder              Int                @default(0)
  razorpayPlanIdMonthly     String?
  razorpayPlanIdYearly      String?
  stripePriceIdMonthly      String?
  stripePriceIdYearly       String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  subscriptions             Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id])
  billingCycle           BillingCycle       @default(MONTHLY)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  invoices               SubscriptionInvoice[]
  depositReceipts        DepositReceipt[]

  @@index([status])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id                    String        @id @default(uuid())
  invoiceNumber         String        @unique
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                Float
  currency              String        @default("INR")
  status                InvoiceStatus @default(DRAFT)
  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  paymentMethod         String?       // RAZORPAY, STRIPE, BANK_TRANSFER
  razorpayPaymentId     String?
  stripePaymentIntentId String?
  pdfUrl                String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscription_invoices")
}

model DepositReceipt {
  id                   String        @id @default(uuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId       String?
  subscription         Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount               Float
  currency             String        @default("INR")
  transactionReference String
  transferDate         DateTime
  receiptUrl           String
  notes                String?
  status               DepositStatus @default(PENDING)
  rejectionReason      String?
  verifiedByUserId     String?
  verifiedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("deposit_receipts")
}
